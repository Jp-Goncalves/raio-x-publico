POSTGRES_USER=raiox
# Gere uma senha forte e cole aqui (nunca neste arquivo de exemplo). Vazia, o Postgres nem sobe:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Atenção: o Postgres só lê esta senha na PRIMEIRA vez que cria o banco. Pra trocar depois,
# rode ALTER USER no banco e atualize também o ~/.dbt/profiles.yml (veja SECURITY.md).
POSTGRES_PASSWORD=
POSTGRES_DB=raiox_publico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API do TCE-SP: https://transparencia.tce.sp.gov.br/api/json/despesas/{cidade}/{ano}/{mes}
API_BASE_URL=https://transparencia.tce.sp.gov.br/api/json/despesas

# Airflow (fase 3) - só preencha pra usar `docker compose --profile airflow up -d`.
# Gere cada chave com o comando indicado e cole no seu .env (nunca neste arquivo):
#   AIRFLOW_FERNET_KEY: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   AIRFLOW_JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
# usuário da interface (a UI só escuta em 127.0.0.1). A senha é obrigatória e não pode ser
# "airflow": o airflow-init se recusa a subir. Gere uma:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=

# Usuário restrito do Airflow (papel User: só dispara execuções) que o dashboard usa pra pedir
# cargas sob demanda. O airflow-init cria o usuário se a senha estiver preenchida. Gere uma:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_AIRFLOW_USER=dashboard
DASHBOARD_AIRFLOW_PASSWORD=
